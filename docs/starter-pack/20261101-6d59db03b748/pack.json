e_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2604.19028", "title": "Learning Posterior Predictive Distributions for Node Classification from Synthetic Graph Priors", "score": 9, "route": "20251101-20261031/2604.19028v1", "published": "2026-04-21", "publication_date": "2026-04-21", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2604.19028v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2602.04596", "title": "Uncertainty Decomposition for Bayes-Filtered Transformers via Bayesian Predictive Inference", "score": 9, "route": "20251101-20261031/2602.04596v2", "published": "2026-02-04", "publication_date": "2026-02-04", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2602.04596v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "贝叶斯滤波Transformer单次前向即输出总预测不确定性，却不显式表示后验，难以拆分偶然与认知不确定性。本文从贝叶斯预测推断视角给出监督场景下的预测中心极限定理，刻画给定上下文后极限预测后验渐近高斯，其方差即认知不确定性。应用于TabPFN后，可信带随上下文增长接近名义频率覆盖，认知不确定性随上下文收缩且集中于稀疏区域，偶然不确定性主导类别重叠的决策边界。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2512.03307", "title": "Robust Tabular Foundation Models", "score": 9, "route": "20251101-20261031/2512.03307v1", "published": "2025-12-02", "publication_date": "2025-12-02", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2512.03307v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "表格基础模型（TFM）可完全依赖合成数据预训练，但现有工作多关注生成器先验质量。本文提出最优性差距度量，将生成器分布参数化并做对抗式训练，使训练聚焦于模型表现落后的困难数据集。在TabPFN V2上应用RTFM后，平均归一化AUC最高提升6%，且仅需不足10万个额外合成数据集。该工作为仅用合成数据对TFM做定向对抗训练与微调提供了新方向。", "tags": [], "reading_status": "complete"}, {"id": "work:130f21a010ef4316fb5ced24", "title": "TabPFN Unleashed: A 