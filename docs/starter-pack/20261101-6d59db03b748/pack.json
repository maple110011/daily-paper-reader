{"run_id": "20261101-6d59db03b748", "tag": "PFN", "status": "content_pending", "paper_count": 92, "as_of": "2026-11-01", "updated_at": "2026-11-01T12:09:40.156399+00:00", "mode": "starter", "result_count": 92, "content_done": 10, "content_pending": 82, "guide_status": "complete", "export_path": "docs/starter-pack/20261101-6d59db03b748/papers.md", "selected_records": [{"id": "arxiv:2601.21731", "title": "Mechanistic Evidence for Spectral Structures in Prior-Data Fitted Networks", "score": 10, "route": "20251101-20261031/2601.21731v2", "published": "2026-01-29", "publication_date": "2026-01-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2601.21731v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "PFN 能单次前向完成摊销贝叶斯推断，但其内部表示是否编码可识别的贝叶斯结构尚不清楚。本文通过探针实验、激活修补与子空间干预，发现频谱信息可从注意力得分中线性解码且被因果使用。作者提出 Filter Bank Decoder，将冻结的 PFN 隐变量映射为显式谱密度并重建平稳核。所得核支持单次前向的高斯过程回归，表明 PFN 先验可作为可移植贝叶斯对象被显式恢复。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.06413", "title": "Decoupled PFNs: Identifiable Epistemic-Aleatoric Decomposition via Structured Synthetic Priors", "score": 10, "route": "20251101-20261031/2605.06413v1", "published": "2026-05-07", "publication_date": "2026-05-07", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.06413v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "PFN 的标准输出是含噪观测的后验预测分布，难以区分认知不确定性与偶然噪声。本文证明该分解在一般情况下不可辨识，转而利用合成先验可控的优势，为每个任务显式标注潜在信号与噪声方差，训练带独立信号头与噪声头的解耦 PFN。实验表明仅认知不确定性驱动的采集策略在噪声与异方差场景下更稳健，在 HPO 与合成 BO 中取得更优平均排名。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.13986", "title": "TabPFN-3: Technical Report", "score": 10, "route": "20251101-20261031/2605.13986v2", "published": "2026-05-13", "publication_date": "2026-05-13", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.13986v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "表格数据是科学与工业高价值预测的核心，TabPFN已推动该模态的基础模型变革。TabPFN-3基于用户反馈，将SOTA性能扩展到100万训练行并大幅降低训练与推理时间，仅用合成数据预训练。在TabArena上单次前向即显著超越调优与集成基线，并帕累托支配速度/性能前沿。其测试时计算扩展TabPFN-3-Plus在TabArena上领先非TabPFN模型超200 Elo，且比AutoGluon 1.5 extreme快10倍。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.13764", "title": "How Well Do Prior-Data Fitted Networks Amortize Bayesian Inference?", "score": 9, "route": "20251101-20261031/2610.13764v1", "published": "2026-10-09", "publication_date": "2026-10-09", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.13764v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.21950", "title": "SelectPFN: Amortized Bayesian Variable Selection for Sparse Nonlinear Regression with Prior-Data Fitted Networks", "score": 9, "route": "20251101-20261031/2610.21950v1", "published": "2026-10-15", "publication_date": "2026-10-15", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.21950v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.37737", "title": "Anisotropic Trust Region Warping for Prior-Data Fitted Networks in Bayesian Optimisation", "score": 9, "route": "20251101-20261031/2610.37737v1", "published": "2026-10-27", "publication_date": "2026-10-27", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.37737v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.14989", "title": "Characterizing the Separability Gap in Prior-Data Fitted Networks", "score": 9, "route": "20251101-20261031/2610.14989v1", "published": "2026-10-10", "publication_date": "2026-10-10", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.14989v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.28314", "title": "Debiased Prior-Data Fitted Networks for Amortized Bayesian Semi-Parametric Inference", "score": 9, "route": "20251101-20261031/2610.28314v1", "published": "2026-10-20", "publication_date": "2026-10-20", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.28314v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2606.11473", "title": "CRUMB: Efficient Prior Fitted Network Inference via Distributionally Matched Context Batching", "score": 9, "route": "20251101-20261031/2606.11473v1", "published": "2026-06-09", "publication_date": "2026-06-09", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2606.11473v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.23073", "title": "Path to Prior-Data Fitted Relational Models via Learned Latent Multi-table Representations", "score": 9, "route": "20251101-20261031/2610.23073v1", "published": "2026-10-16", "publication_date": "2026-10-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.23073v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.15928", "title": "Prior-Data Fitted Networks for Causal Inference: a Simulation Study with Real-World Scenarios", "score": 9, "route": "20251101-20261031/2603.15928v2", "published": "2026-03-16", "publication_date": "2026-03-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.15928v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2608.19735", "title": "RecPFN: Prior-Fitted Networks for In-Context-Based Recommendations", "score": 9, "route": "20251101-20261031/2608.19735v1", "published": "2026-08-20", "publication_date": "2026-08-20", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.19735v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2512.11840", "title": "Amortized Causal Discovery with Prior-Fitted Networks", "score": 9, "route": "20251101-20261031/2512.11840v1", "published": "2025-12-03", "publication_date": "2025-12-03", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2512.11840v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "可微惩罚似然方法依赖似然估计优化因果结构，但似然误差即使在大样本下也会导致结构发现失败。本文提出摊销因果发现方法，用Prior-Fitted Networks摊销数据相关的似然估计，为结构学习提供更可靠评分。在合成、模拟与真实数据上，结构恢复显著优于标准基线，并直接证明PFN的似然估计比传统神经网络更准确。", "tags": [], "reading_status": "complete"}, {"id": "work:652a67c0ddec5e38e1eda1b2", "title": "Bayesian Neural Scaling Law Extrapolation with Prior-Data Fitted Networks", "score": 9, "route": "conference/icml-2025/openreview-icml-2025-xsyrolw1q1-bayesian-neural-scaling-law-extrapolation-with-prior-data-fitted-networks", "published": "2025-10-06", "publication_date": "2025-10-06", "publication_date_precision": "day", "publication_date_source": "https://raw.githubusercontent.com/mlresearch/v267/gh-pages/_config.yml", "publication_date_kind": "proceedings", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2607.29120", "title": "Curriculum Matters: Data-Efficient Relational PFN Pretraining with Synthetic Data", "score": 9, "route": "20251101-20261031/2607.29120v1", "published": "2026-07-31", "publication_date": "2026-07-31", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2607.29120v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.07804", "title": "Adaptive Mean Estimation by In-Context Learning: A Gradient-Flow Analysis", "score": 9, "route": "20251101-20261031/2610.07804v1", "published": "2026-10-06", "publication_date": "2026-10-06", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.07804v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.12037", "title": "Frequentist Consistency of Prior-Data Fitted Networks for Causal Inference", "score": 9, "route": "20251101-20261031/2603.12037v3", "published": "2026-03-12", "publication_date": "2026-03-12", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.12037v3", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2601.21656", "title": "TabClustPFN: A Prior-Fitted Network for Tabular Data Clustering", "score": 9, "route": "20251101-20261031/2601.21656v3", "published": "2026-01-29", "publication_date": "2026-01-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2601.21656v3", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "表格数据聚类因特征异构、生成机制多样而缺乏可迁移归纳偏置。TabClustPFN 将先验拟合网络扩展到无监督聚类，在合成聚类先验上预训练，单次前向即可同时推断簇分配与簇数。实验在合成数据与真实表格基准上优于经典、深度及摊销聚类基线，且无需按数据集重训或调参。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.26713", "title": "Transformers Can Learn Posterior Predictive Distributions In-Context", "score": 9, "route": "20251101-20261031/2605.26713v1", "published": "2026-05-26", "publication_date": "2026-05-26", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.26713v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.11090", "title": "Interventional Time Series Priors for Causal Foundation Models", "score": 9, "route": "20251101-20261031/2603.11090v2", "published": "2026-03-11", "publication_date": "2026-03-11", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.11090v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2605.21742", "title": "Correcting Class Imbalance in Prior-Data Fitted Networks for Tabular Classification", "score": 9, "route": "20251101-20261031/2605.21742v1", "published": "2026-05-20", "publication_date": "2026-05-20", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.21742v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "work:a6f8064e6bd07bfcae774c9b", "title": "Do-PFN: In-Context Learning for Causal Effect Estimation", "score": 9, "route": "conference/neurips-2025/openreview-neurips-2025-oanbl9b56b-do-pfn-in-context-learning-for-causal-effect-estimation", "published": "2025", "publication_date": "2025", "publication_date_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "work:646adb12206e95fe9f5f882e", "title": "Effortless, Simulation-Efficient Bayesian Inference using Tabular Foundation Models", "score": 9, "route": "conference/neurips-2025/openreview-neurips-2025-kn0yhwgdph-effortless-simulation-efficient-bayesian-inference-using-tabular-foundation-models", "published": "2025", "publication_date": "2025", "publication_date_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2602.20223", "title": "MultiModalPFN: Extending Prior-Data Fitted Networks for Multimodal Tabular Learning", "score": 9, "route": "20251101-20261031/2602.20223v3", "published": "2026-02-23", "publication_date": "2026-02-23", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2602.20223v3", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "TabPFN作为表格基础模型难以融合图像、文本等异构模态，限制了其在医疗、营销等场景的应用。MMPFN通过各模态编码器、模态投影器和预训练基础模型，将非表格嵌入转为表格兼容token统一处理。在医疗与通用多模态数据集上持续优于现有方法，有效利用非表格模态。该工作将先验数据拟合网络扩展到多模态表格学习，提供可扩展框架。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.20234", "title": "TabPFN-MT: A Natively Multitask In-Context Learner for Tabular Data", "score": 9, "route": "20251101-20261031/2605.20234v1", "published": "2026-05-16", "publication_date": "2026-05-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.20234v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2606.21776", "title": "A Causal DAG Prior for Synthetic Time-Series Classification Datasets", "score": 9, "route": "20251101-20261031/2606.21776v1", "published": "2026-06-19", "publication_date": "2026-06-19", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2606.21776v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.15802", "title": "Time-Aware Prior Fitted Networks for Zero-Shot Forecasting with Exogenous Variables", "score": 9, "route": "20251101-20261031/2603.15802v2", "published": "2026-03-16", "publication_date": "2026-03-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.15802v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2605.19662", "title": "When Tabular Foundation Models Meet Strategic Tabular Data: A Prior Alignment Approach", "score": 9, "route": "20251101-20261031/2605.19662v2", "published": "2026-05-19", "publication_date": "2026-05-19", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.19662v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2606.15752", "title": "One Sequential Recommendation Model Pretrained from Synthetic Priors Predicts Multiple Datasets", "score": 9, "route": "20251101-20261031/2606.15752v1", "published": "2026-06-14", "publication_date": "2026-06-14", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2606.15752v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "work:d1b0a13638c92a055b85511e", "title": "Zero-shot Meta-learning for Tabular Prediction Tasks with Adversarially Pre-trained Transformer", "score": 9, "route": "conference/icml-2025/openreview-icml-2025-q9litfnkds-zero-shot-meta-learning-for-tabular-prediction-tasks-with-adversarially-pre-trained-transformer", "published": "2025-10-06", "publication_date": "2025-10-06", "publication_date_precision": "day", "publication_date_source": "https://raw.githubusercontent.com/mlresearch/v267/gh-pages/_config.yml", "publication_date_kind": "proceedings", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2603.03805", "title": "Relational In-Context Learning via Synthetic Pre-training with Structural Prior", "score": 9, "route": "20251101-20261031/2603.03805v5", "published": "2026-03-04", "publication_date": "2026-03-04", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2603.03805v5", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "关系数据库缺乏类似文本、视觉的基础模型，核心障碍是高质量RDB私有、稀缺且结构异构，难以进行互联网规模预训练。作者提出RDB-PFN，首个纯用合成数据训练的关系基础模型，借助结构因果模型构建关系先验生成器，从零生成无限多样的RDB。在超200万合成单表与关系任务上预训练后，模型可通过真正的上下文学习即时适配新数据库。在19个真实关系预测任务上取得强少样本性能，优于同输入的表格基础模型。", "tags": [], "reading_status": "complete"}, {"id": "work:481ecb29954db45d1082b626", "title": "EquiTabPFN: A Target-Permutation Equivariant Prior Fitted Network", "score": 9, "route": "conference/neurips-2025/openreview-neurips-2025-lrnzdu9g7n-equitabpfn-a-target-permutation-equivariant-prior-fitted-network", "published": "2025", "publication_date": "2025", "publication_date_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2604.08400", "title": "Zero-shot Multivariate Time Series Forecasting Using Tabular Prior Fitted Networks", "score": 9, "route": "20251101-20261031/2604.08400v1", "published": "2026-04-09", "publication_date": "2026-04-09", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2604.08400v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2605.07765", "title": "Pre-trained Tabular Foundation Models as Versatile Summary Networks for Neural Posterior Estimation", "score": 9, "route": "20251101-20261031/2605.07765v1", "published": "2026-05-08", "publication_date": "2026-05-08", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.07765v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.12904", "title": "GIST: Generator-state-Informed Supervision for Tabular Foundation Models", "score": 9, "route": "20251101-20261031/2610.12904v1", "published": "2026-10-09", "publication_date": "2026-10